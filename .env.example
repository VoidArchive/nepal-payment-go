# Nepal Payment Go - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# KHALTI
# =============================================================================
# Get your secret key from https://test-admin.khalti.com (sandbox)
# or https://admin.khalti.com (production)
KHALTI_SECRET_KEY=

# =============================================================================
# ESEWA
# =============================================================================
# For sandbox testing, you can leave these empty (defaults will be used)
# For production, get credentials from https://merchant.esewa.com.np
ESEWA_SECRET_KEY=
ESEWA_PRODUCT_CODE=

# =============================================================================
# CONNECTIPS
# =============================================================================
# Get credentials by onboarding with Nepal Clearing House (NCHL)
# https://connectips.com
CONNECTIPS_MERCHANT_ID=
CONNECTIPS_APP_ID=
CONNECTIPS_APP_NAME=
CONNECTIPS_CERT_PATH=          # Path to .pfx or .pem certificate file
CONNECTIPS_CERT_PASSWORD=      # Password for .pfx file

# =============================================================================
# FONEPAY
# =============================================================================
# Get credentials from FonePay merchant registration
# For sandbox, use defaults: NBQM / a7e3512f5032480a83137793cb2021dc
FONEPAY_MERCHANT_CODE=
FONEPAY_SECRET_KEY=

# QR API credentials (optional, only needed for GenerateQR)
# Request from your bank after FonePay merchant registration
FONEPAY_USERNAME=
FONEPAY_PASSWORD=

# =============================================================================
# SANDBOX DEFAULTS (for reference only, don't set these)
# =============================================================================
# eSewa Sandbox:
#   ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
#   ESEWA_PRODUCT_CODE=EPAYTEST
#
# FonePay Sandbox:
#   FONEPAY_MERCHANT_CODE=NBQM
#   FONEPAY_SECRET_KEY=a7e3512f5032480a83137793cb2021dc
#
# eSewa Test Users: 9806800001-5 / Nepal@123 / Token: 123456
# Khalti Test Users: 9800000001-5 / MPIN: 1111 / OTP: 987654
#
# ConnectIPS: Sandbox credentials provided upon merchant onboarding with NCHL
